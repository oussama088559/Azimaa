{
  "name": "azima",
  "private": true,
  "version": "1.0.0",
  "description": "Azima — daily habit tracker",
  "author": "Azima",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": { "dev": "vite --port=3000", "build": "vite build", "electron": "npm run build && electron .", "dist": "npm run build && electron-builder --win", "android:add": "cap add android", "android:sync": "npm run build && cap sync android", "android:open": "cap open android" },
  "devDependencies": {
    "@capacitor/android": "^7.0.0", "@capacitor/cli": "^7.0.0", "@capacitor/core": "^7.0.0", "@capacitor/local-notifications": "^7.0.0",
    "@fontsource/cairo": "^5.2.0", "@fontsource/reem-kufi": "^5.2.0",
    "@types/react": "^19.3.0", "@types/react-dom": "^19.3.0", "@vitejs/plugin-react": "^6.1.1",
    "electron": "^39.0.0", "electron-builder": "^26.0.12", "react": "^19.0.1", "react-dom": "^19.0.1", "typescript": "^5.6.0", "vite": "^8.3.0"
  },
  "build": {
    "appId": "com.azima.app", "productName": "Azima",
    "directories": { "output": "release", "buildResources": "electron/resources" },
    "files": ["dist/**/*", "electron/**/*", "package.json"],
    "win": { "icon": "electron/resources/icon.ico", "target": [{ "target": "nsis", "arch": ["x64"] }, { "target": "portable", "arch": ["x64"] }] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true }
  }
}
